<div class="vvjob vv2 {{{ if isPopular }}}vvhot{{{ end }}}" lang="vi">
  <div class="vv2-layout">
    <aside class="vv2-left" aria-label="Điều hướng cộng đồng">
      <!-- IMPORT partials/vvjob-local-rail.tpl -->
    </aside>

    <section class="vv2-feed" id="vvjob-feed" aria-label="Bảng tin cộng đồng">
      {{{ if isPopular }}}<!-- IMPORT partials/vvjob-popular.tpl -->{{{ else }}}
      {{{ if (!hasCommunity && !circle) }}}<div class="vvjob-stream-heading"><div><span>GÓC CHUYỆN ĐI LÀM</span><h1>Một chút chuyện công sở.</h1></div><a href="{config.relative_path}/search" aria-label="Tìm kiếm"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></a></div>{{{ end }}}
      {{{ if hasCommunity }}}<header class="vvjob-community-context"><i class="fa fa-comments-o" aria-hidden="true"></i><h1>{feedTitle}</h1><a href="{config.relative_path}/vvjob" aria-label="Xem tất cả bài viết"><i class="fa fa-times" aria-hidden="true"></i></a></header>{{{ else }}}<span class="visually-hidden">Cộng đồng VVJOB</span>{{{ end }}}

      {{{ if circle }}}<header class="vvjob-circle-heading"><h1>{{{ if isCoworkers }}}Đồng nghiệp{{{ else }}}Vòng kết nối{{{ end }}}</h1><p>{{{ if isCoworkers }}}Bài viết gần đây từ hồ sơ công khai cùng công ty.{{{ else }}}Bài viết gần đây từ những người bạn theo dõi.{{{ end }}}</p>{{{ if circleNeedsLogin }}}<a href="{config.relative_path}/login">Đăng nhập để tiếp tục</a>{{{ else }}}{{{ if circleNeedsCompany }}}<a href="{config.relative_path}/vvjob/career">Thêm công ty của bạn</a>{{{ else }}}{{{ if isNetwork }}}<a href="{config.relative_path}/users">Khám phá và theo dõi đồng nghiệp</a>{{{ end }}}{{{ end }}}{{{ end }}}</header>{{{ end }}}
      {{{ if showCareerReminder }}}<aside class="vvjob-career-reminder" aria-label="Gợi ý hoàn thiện hồ sơ"><i class="fa fa-briefcase" aria-hidden="true"></i><div><strong>Thêm công ty và vị trí khi bạn sẵn sàng.</strong><p>Không bắt buộc. Thông tin mặc định riêng tư, chưa được xác minh.</p><a href="{config.relative_path}/vvjob/career">Hoàn thiện hồ sơ →</a></div><button class="btn btn-link" type="button" data-career-dismiss aria-label="Để sau, đóng gợi ý hồ sơ">Để sau</button><span class="vvjob-career-feedback" role="status"></span></aside>{{{ end }}}
      <section class="vv2-compose vvjob-social-compose" aria-label="Chia sẻ bài viết"><div class="vv2-compose-main"><a data-vvjob-avatar-uid="{viewer.uid}" class="vv2-compose-avatar" href="{config.relative_path}{{{ if viewerLoggedIn }}}/user/{viewer.userslug}{{{ else }}}/login{{{ end }}}" aria-label="Trang cá nhân">{{{ if viewer.avatar.picture }}}<img src="{viewer.avatar.picture}" alt="" data-vvjob-viewer-avatar>{{{ else }}}{{{ if viewerLoggedIn }}}<span class="vvjob-letter-avatar" style="background-color:{viewer.avatar.color}">{viewer.avatar.initial}</span>{{{ else }}}<i class="fa fa-user-o" aria-hidden="true"></i>{{{ end }}}{{{ end }}}</a><button type="button" data-vvjob-compose data-cid="{selectedCommunityId}">Bạn muốn chia sẻ điều gì?</button></div></section>
      {{{ if !circle }}}<nav class="vv2-feed-tabs" aria-label="Sắp xếp bảng tin"><div><a class="{{{ if isRecommended }}}selected{{{ end }}}" href="{config.relative_path}/vvjob{feedQuery}" {{{ if isRecommended }}}aria-current="page"{{{ end }}}>Dành cho bạn</a><a class="{{{ if isLatest }}}selected{{{ end }}}" href="{config.relative_path}/vvjob{latestQuery}" {{{ if isLatest }}}aria-current="page"{{{ end }}}>Mới nhất</a><a href="{config.relative_path}/vvjob{popularQuery}">Nổi bật</a></div></nav>{{{ if isRecommended }}}{{{ end }}}{{{ end }}}
      <div class="vv2-posts">{{{ each topics }}}
        <!-- IMPORT partials/vvjob-feed-card.tpl -->
      {{{ end }}}{{{ if !topics.length }}}<section class="vv2-empty"><span aria-hidden="true">✳</span><h2>Câu chuyện đầu tiên bắt đầu từ bạn</h2><p>Chưa có bài viết để hiển thị. Hãy mở một cuộc trò chuyện về công việc của bạn.</p><button type="button" class="vv2-button" data-vvjob-compose data-cid="{selectedCommunityId}">Chia sẻ câu chuyện <span aria-hidden="true">↗</span></button></section>{{{ end }}}</div>
      {{{ end }}}
      {{{ if (!isPopular && !circle) }}}<!-- IMPORT partials/paginator.tpl -->{{{ end }}}
      <footer class="vvjob-feed-footer"><a href="{config.relative_path}/vvjob/guide">Hướng dẫn cộng đồng</a><span aria-hidden="true">·</span><span>VVJOB · Real Work. Real Talk.</span></footer>
    </section>
    <aside class="vv2-right" aria-label="Chủ đề nổi bật"><!-- IMPORT partials/vvjob-local-context.tpl -->{{{ if isPopular }}}<section class="vvhot-explainer"><span class="vvhot-explainer-icon"><i class="fa fa-line-chart" aria-hidden="true"></i></span><h2>Cộng đồng đang nói gì?</h2><p>Những cuộc trò chuyện được cộng đồng quan tâm.</p><div><i class="fa fa-comments-o" aria-hidden="true"></i><span>Thứ hạng dựa trên hoạt động thảo luận gần đây.</span></div><a href="{config.relative_path}/vvjob/guide">Cùng xây dựng cuộc trò chuyện tốt hơn <i class="fa fa-angle-right" aria-hidden="true"></i></a></section>{{{ else }}}<section class="vv2-trending"><header><span class="vv2-flame" aria-hidden="true"><i class="fa fa-fire"></i></span><h2>Đang được bàn luận</h2><span class="vv2-week">TUẦN NÀY</span></header><ol>{{{ each trending }}}<li><div><a href="{config.relative_path}/topic/{./slug}">{./title}</a></div></li>{{{ end }}}</ol>{{{ if !trending.length }}}<p class="vv2-no-trending">Những cuộc thảo luận nổi bật sẽ xuất hiện tại đây.</p>{{{ end }}}<a class="vv2-trending-all" href="{config.relative_path}/vvjob?sort=popular">Xem các cuộc thảo luận <span aria-hidden="true">→</span></a></section>
      {{{ end }}}
      <section class="vvjob-local-topics"><h3>Tìm góc của bạn</h3>{{{ each communities }}}<a href="{config.relative_path}/vvjob?cid={./cid}">{./name}<span aria-hidden="true">↗</span></a>{{{ end }}}</section><p class="vvjob-local-fineprint">Tôn trọng khác biệt. Bảo vệ riêng tư.<br>VVJOB · Cộng đồng người đi làm</p>
    </aside>
  </div>

</div>
