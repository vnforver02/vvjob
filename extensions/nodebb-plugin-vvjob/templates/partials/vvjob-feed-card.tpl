        <article class="vv2-post" data-feed-tid="{./tid}" data-feed-key="{./domId}"><header class="vv2-post-header"><a data-vvjob-avatar-uid="{./avatar.uid}" class="vv2-avatar" href="{config.relative_path}/user/{./user.userslug}" aria-label="Hồ sơ {./user.displayname}">{{{ if ./avatar.picture }}}<img src="{./avatar.picture}" alt="" loading="lazy">{{{ else }}}<span class="vvjob-letter-avatar" style="background-color:{./avatar.color}">{./avatar.initial}</span>{{{ end }}}</a><div class="vv2-author"><div class="vvjob-author-name"><a href="{config.relative_path}/user/{./user.userslug}">{./user.displayname}</a><!-- IMPORT partials/vvjob-author-badge.tpl --></div>{{{ if ./authorMeta.careerLine }}}<span class="vvjob-author-career">{./authorMeta.careerLine}</span>{{{ end }}}<span class="vvjob-local-time"><span class="timeago" title="{./timestampISO}"></span></span></div><a class="vv2-more" href="{config.relative_path}/topic/{./slug}" aria-label="Mở bài viết"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg></a></header><!-- IMPORT partials/vvjob-post-body.tpl --><a class="vvjob-local-topic-tag" href="{config.relative_path}/vvjob?cid={./category.cid}">{./category.name}</a>{{{ if ./tags.length }}}<nav class="vvjob-post-hashtags" aria-label="Chủ đề bài viết">{{{ each ./tags }}}<a href="{config.relative_path}/tags/{./valueEncoded}">#{./value}</a>{{{ end }}}</nav>{{{ end }}}<!-- IMPORT partials/vvjob-social-actions.tpl -->
{{{ if ./highlight }}}<a class="vvjob-highlight" href="{config.relative_path}/post/{./highlight.pid}"><span>Bình luận nổi bật</span><p>{./highlight.preview}</p><i class="fa fa-angle-right" aria-hidden="true"></i></a>{{{ end }}}

        </article>
