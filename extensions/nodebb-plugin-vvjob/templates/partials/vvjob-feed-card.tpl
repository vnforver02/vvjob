        <article class="vv2-post" data-feed-tid="{./tid}"><header class="vv2-post-header"><a class="vv2-avatar" href="{config.relative_path}/user/{./user.userslug}" aria-label="Hồ sơ {./user.displayname}">{{{ if ./user.picture }}}<img src="{./user.picture}" alt="" loading="lazy">{{{ else }}}<i class="fa fa-user-o" aria-hidden="true"></i>{{{ end }}}</a><div class="vv2-author"><div class="vvjob-author-name"><a href="{config.relative_path}/user/{./user.userslug}">{./user.displayname}</a><!-- IMPORT partials/vvjob-author-badge.tpl --></div>{{{ if ./authorMeta.careerLine }}}<span class="vvjob-author-career">{./authorMeta.careerLine}</span>{{{ end }}}<span>Chia sẻ trong <a href="{config.relative_path}/category/{./category.slug}">{./category.name}</a></span></div><a class="vv2-more" href="{config.relative_path}/topic/{./slug}" aria-label="Mở bài viết"><i class="fa fa-ellipsis-h" aria-hidden="true"></i></a></header><!-- IMPORT partials/vvjob-post-body.tpl --><!-- IMPORT partials/vvjob-social-actions.tpl -->
{{{ if ./highlight }}}<a class="vvjob-highlight" href="{config.relative_path}/post/{./highlight.pid}"><span>Bình luận nổi bật</span><p>{./highlight.preview}</p><i class="fa fa-angle-right" aria-hidden="true"></i></a>{{{ end }}}
