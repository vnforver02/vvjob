<h2><button type="button" data-vvjob-expand aria-expanded="false" aria-controls="vvbody-{./domId}">{./title}</button></h2>
<div class="vvjob-post-body" id="vvbody-{./domId}"><div class="vvjob-post-preview">{./socialPost.preview}</div>{{{ if ./socialPost.images.length }}}<div class="vvjob-media vvjob-media-{./socialPost.imageCount}" aria-label="Ảnh trong bài viết">{{{ each ./socialPost.images }}}<button type="button" data-vvjob-image="{./index}" {{{ if ./overflow }}}data-image-overflow="true"{{{ end }}} aria-label="Mở ảnh trong bài viết"><img src="{./src}" alt="Ảnh trong bài viết" loading="lazy" decoding="async">{{{ if ./overflow }}}<span>+{./overflow}</span>{{{ end }}}</button>{{{ end }}}</div>{{{ end }}}<div class="vvjob-post-original" hidden></div><button type="button" class="vvjob-expand-control" data-vvjob-expand aria-expanded="false" aria-controls="vvbody-{./domId}" aria-label="Mở nội dung bài viết ngay tại đây" title="Mở nội dung"><i class="fa fa-angle-down" aria-hidden="true"></i></button></div><p class="vvjob-content-status visually-hidden" role="status"></p>
