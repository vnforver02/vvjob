<h2 class="vvjob-feed-title"><a data-vvjob-post-open href="{config.relative_path}/topic/{./slug}">{./title}</a></h2>
<div class="vvjob-post-body" id="vvbody-{./domId}"><a class="vvjob-post-preview" data-vvjob-post-open href="{config.relative_path}/topic/{./slug}">{./socialPost.preview}</a>{{{ if ./socialPost.images.length }}}<div class="vvjob-media vvjob-media-{./socialPost.imageCount}" aria-label="Ảnh trong bài viết">{{{ each ./socialPost.images }}}<button type="button" data-vvjob-image="{./index}" {{{ if ./overflow }}}data-image-overflow="true"{{{ end }}} aria-label="Mở ảnh trong bài viết"><img src="{./src}" alt="Ảnh trong bài viết" loading="lazy" decoding="async">{{{ if ./overflow }}}<span>+{./overflow}</span>{{{ end }}}</button>{{{ end }}}</div>{{{ end }}}</div>
