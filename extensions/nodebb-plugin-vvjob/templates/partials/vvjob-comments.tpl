{{{ each comments }}}
<li class="vvcomment" data-comment-pid="{./pid}" data-comment-parent="{./toPid}">
  <a class="vvcomment-avatar" href="{config.relative_path}/user/{./user.userslug}" aria-label="Hồ sơ {./user.displayname}">{{{ if ./user.picture }}}<img src="{./user.picture}" alt="" loading="lazy">{{{ else }}}<i class="fa fa-user-o" aria-hidden="true"></i>{{{ end }}}</a>
  <div class="vvcomment-main"><div class="vvcomment-bubble"><a class="vvcomment-author" href="{config.relative_path}/user/{./user.userslug}">{./user.displayname}</a><!-- IMPORT partials/vvjob-author-badge.tpl -->{{{ if ./isTopicAuthor }}}<span class="vvcomment-owner">Tác giả</span>{{{ end }}}{{{ if ./authorMeta.careerLine }}}<span class="vvcomment-career">{./authorMeta.careerLine}</span>{{{ end }}}{{{ if ./replyTo }}}<span class="vvcomment-parent">Trả lời {./replyTo}</span>{{{ end }}}<div class="vvcomment-content">{./content}</div></div>
  <div class="vvcomment-meta"><button type="button" class="vvcomment-like" data-vvjob-like="{./pid}" aria-label="Thích bình luận" title="Thích bình luận" aria-pressed="{{{ if ./liked }}}true{{{ else }}}false{{{ end }}}" {{{ if ./selfPost }}}disabled{{{ end }}}><i class="fa {{{ if ./liked }}}fa-thumbs-up{{{ else }}}fa-thumbs-o-up{{{ end }}}" aria-hidden="true"></i><span data-like-count>{{{ if ./likes }}}{./likes}{{{ end }}}</span></button><time data-comment-time="{./timestamp}"></time>{{{ if canReply }}}<button type="button" data-comment-reply="{./pid}" data-name="{./user.displayname}">Trả lời</button>{{{ end }}}<a href="{config.relative_path}/post/{./pid}" aria-label="Mở bình luận và tùy chọn báo cáo" title="Tùy chọn bình luận"><i class="fa fa-ellipsis-h" aria-hidden="true"></i></a></div></div>
</li>
{{{ end }}}
