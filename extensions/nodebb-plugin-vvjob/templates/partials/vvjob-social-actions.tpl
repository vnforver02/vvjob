<footer class="vv2-post-actions vvjob-conversation-actions" aria-label="Tương tác bài viết">
  {{{ if ./socialPost }}}<button type="button" data-vvjob-like="{./socialPost.pid}" aria-label="Thích" aria-pressed="{{{ if ./socialPost.liked }}}true{{{ else }}}false{{{ end }}}" >{{{ if ./socialPost.reactions.useEmoji }}}<span data-reaction-icon class="vvjob-selected-emoji" aria-hidden="true">{./socialPost.reactions.selectedEmoji}</span>{{{ else }}}<i class="fa {{{ if ./socialPost.liked }}}fa-heart{{{ else }}}fa-heart-o{{{ end }}}" aria-hidden="true"></i>{{{ end }}}<span data-like-count>{{{ if ./socialPost.likes }}}{./socialPost.likes}{{{ end }}}</span></button>{{{ end }}}
  <a class="vvjob-thread-link" data-vvjob-open-thread href="{config.relative_path}/topic/{./slug}#vvjob-replies" aria-label="Bình luận"><svg class="vvjob-action-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-8 8 9 9 0 0 1-3.6-.8L4 20l1.3-4.4a8 8 0 1 1 14.7-4.1Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span>{{{ if ./replyCount }}}{./replyCount}{{{ end }}}</span></a>
  <button type="button" data-vvjob-share data-url="{config.relative_path}/topic/{./slug}" data-title="{./title}" aria-label="Chia sẻ"><svg class="vvjob-action-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 3-7 18-4-7-7-4 18-7ZM10 14 21 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <span class="vvjob-share-feedback" role="status" aria-live="polite"></span>
</footer>
