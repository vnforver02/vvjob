{
  "id": "nodebb-plugin-vvjob",
  "name": "VVJOB Community",
  "description": "Vietnamese workplace feed for NodeBB Harmony",
  "library": "./library.js",
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "filter:homepage.get",
      "method": "homepages"
    },
    {
      "hook": "action:homepage.get:vvjob",
      "method": "home"
    },
    {
      "hook": "filter:helpers.getUserDataByUserSlug",
      "method": "careerProfile"
    },
    {
      "hook": "filter:user.profileMenu",
      "method": "careerMenu"
    },
    {
      "hook": "filter:register.complete",
      "method": "registered"
    },
    {
      "hook": "static:user.delete",
      "method": "deleteCareer"
    },
    {
      "hook": "filter:topic.getPosts",
      "method": "decoratePosts"
    }
  ],
  "templates": "./templates",
  "scripts": [
    "public/vvjob.js",
    "public/select.js",
    "public/career.js",
    "public/verification.js",
    "public/evidence.js",
    "public/people.js",
    "public/comments.js",
    "public/reactions.js",
    "public/social.js",
    "public/composer-ui.js",
    "public/chat-ui.js"
  ],
  "scss": [
    "./scss/vvjob.scss",
    "./scss/global.scss",
    "./scss/pages.scss",
    "./scss/concept.scss",
    "./scss/people.scss",
    "./scss/editor.scss"
  ],
  "languages": "./languages"
}
